using System;
using System.Collections.Generic;
using System.Linq;

namespace LogisticsAutoSpeed
{
    // A. Abstract Class PhuongTien
    public abstract class PhuongTien
    {
        private string _maPT;
        private string _tenHang;
        private int _namSanXuat;
        private decimal _giaGoc;

        public string MaPT
        {
            get => _maPT;
            set => _maPT = string.IsNullOrWhiteSpace(value) ? "PT000" : value;
        }

        public string TenHang
        {
            get => _tenHang;
            set
            {
                if (string.IsNullOrWhiteSpace(value)) 
                    throw new ArgumentException("Tên hãng không được để trống.");
                _tenHang = value;
            }
        }

        public int NamSanXuat
        {
            get => _namSanXuat;
            set
            {
                if (value < 1900 || value > DateTime.Now.Year)
                    throw new ArgumentException("Năm sản xuất không hợp lệ!");
                _namSanXuat = value;
            }
        }

        public decimal GiaGoc
        {
            get => _giaGoc;
            set
            {
                if (value <= 0) 
                    throw new ArgumentException("Giá gốc phải lớn hơn 0.");
                _giaGoc = value;
            }
        }

        protected PhuongTien(string maPT, string tenHang, int namSanXuat, decimal giaGoc)
        {
            MaPT = maPT;
            TenHang = tenHang;
            NamSanXuat = namSanXuat;
            GiaGoc = giaGoc;
        }

        public abstract decimal TinhGiaLanBanh();

        public virtual string GetInfo()
        {
            return $"Mã: {MaPT,-5} | Hãng: {TenHang,-10} | Năm: {NamSanXuat} | Giá gốc: {GiaGoc:N0} VNĐ";
        }
    }

    // B. Class OTo
    public class OTo : PhuongTien
    {
        public int SoChoNgoi { get; set; }
        public double DungTichDongCo { get; set; }

        public OTo(string maPT, string tenHang, int namSanXuat, decimal giaGoc, int soChoNgoi, double dungTichDongCo)
            : base(maPT, tenHang, namSanXuat, giaGoc)
        {
            SoChoNgoi = soChoNgoi;
            DungTichDongCo = dungTichDongCo;
        }

        public override decimal TinhGiaLanBanh()
        {
            if (SoChoNgoi <= 9)
                return GiaGoc + (0.12m * GiaGoc) + (0.30m * GiaGoc); // Trước bạ 12%, TTĐB 30%
            else
                return GiaGoc + (0.10m * GiaGoc); // Trước bạ 10%
        }

        public override string GetInfo()
        {
            return base.GetInfo() + $" | Chỗ: {SoChoNgoi} | Động cơ: {DungTichDongCo}L (Ô tô)";
        }
    }

    // C. Class XeMay
    public class XeMay : PhuongTien
    {
        public int DungTichXylanh { get; set; }

        public XeMay(string maPT, string tenHang, int namSanXuat, decimal giaGoc, int dungTichXylanh)
            : base(maPT, tenHang, namSanXuat, giaGoc)
        {
            DungTichXylanh = dungTichXylanh;
        }

        public override decimal TinhGiaLanBanh()
        {
            if (DungTichXylanh < 175)
                return GiaGoc + (0.02m * GiaGoc); // Trước bạ 2%
            else
                return GiaGoc + (0.05m * GiaGoc); // Trước bạ 5%
        }

        public override string GetInfo()
        {
            return base.GetInfo() + $" | Phân khối: {DungTichXylanh}cc (Xe máy)";
        }
    }

    // D. Class QuanLyPhuongTien
    public class QuanLyPhuongTien
    {
        private List<PhuongTien> listPT = new List<PhuongTien>();

        public void AddPhuongTien(PhuongTien pt)
        {
            listPT.Add(pt);
        }

        public void DisplayAll()
        {
            foreach (var pt in listPT)
            {
                Console.WriteLine($"{pt.GetInfo()} -> GIÁ LĂN BÁNH: {pt.TinhGiaLanBanh():N0} VNĐ");
            }
        }

        public PhuongTien FindMaxGiaLanBanh()
        {
            if (listPT.Count == 0) return null;
            return listPT.OrderByDescending(pt => pt.TinhGiaLanBanh()).FirstOrDefault();
        }

        public List<PhuongTien> SearchByName(string keyword)
        {
            // Sử dụng LINQ
            return listPT.Where(pt => pt.TenHang.Contains(keyword, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

