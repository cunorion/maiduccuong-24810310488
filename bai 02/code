            // TC05: Kiểm tra Tìm Giá Lăn Bánh Max
            Console.WriteLine("\n[TC05] - Tìm phương tiện có giá lăn bánh lớn nhất:");
            PhuongTien maxPT = ql.FindMaxGiaLanBanh();
            if (maxPT != null)
            {
                Console.WriteLine($"-> Phương tiện Max: {maxPT.TenHang} - {maxPT.TinhGiaLanBanh():N0} VNĐ");
            }
            
            Console.ReadLine();
        }
    }
