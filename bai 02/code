            Console.WriteLine($"-> Giá lăn bánh: {oToTC02.TinhGiaLanBanh():N0} VNĐ (Kỳ vọng: 1,420,000,000 VNĐ)");

            // TC03: Kiểm tra Tính Giá Lăn Bánh Xe máy
            Console.WriteLine("\n[TC03] - Tính giá lăn bánh Xe máy (150cc, 50 Triệu):");
            Console.WriteLine($"-> Giá lăn bánh: {xeMayTC03.TinhGiaLanBanh():N0} VNĐ (Kỳ vọng: 51,000,000 VNĐ)");

            // TC04: Kiểm tra Đa hình List<PhuongTien>
            Console.WriteLine("\n[TC04] - Gọi đa hình trong danh sách:");
