using System;
using System.Collections.Generic;
using System.Linq;

namespace AutoSpeedLogistics
{
    // ==========================================
    // 1. ABSTRACT CLASS: Phương Tiện (Trừu tượng)
    // ==========================================
    public abstract class PhuongTien
    {
        // Encapsulation (Đóng gói): Các trường dữ liệu private
        private string _maPT;
        private string _tenHang;
        private int _namSanXuat;
        private decimal _giaGoc;

        // Properties với Validation
        public string MaPT
        {
            get => _maPT;
            set => _maPT = string.IsNullOrWhiteSpace(value) ? "PT000" : value.Trim();
        }

        public string TenHang
        {
            get => _tenHang;
            set
            {
                if (string.IsNullOrWhiteSpace(value))
                    throw new ArgumentException("Tên hãng không được để trống!");
                _tenHang = value.Trim();
            }
        }

        public int NamSanXuat
        {
            get => _namSanXuat;
            set
            {
                int currentYear = DateTime.Now.Year;
                if (value < 1900 || value > currentYear)
                    throw new ArgumentException("Năm sản xuất không hợp lệ!");
                _namSanXuat = value;
            }
        }

        public decimal GiaGoc
        {
            get => _giaGoc;
            set
            {
                if (value <= 0)
                    throw new ArgumentException("Giá gốc phải lớn hơn 0!");
                _giaGoc = value;
            }
        }

        // Constructor
        protected PhuongTien(string maPT, string tenHang, int namSanXuat, decimal giaGoc)
        {
            MaPT = maPT;
            TenHang = tenHang;
            NamSanXuat = namSanXuat;
            GiaGoc = giaGoc;
        }

        // Abstraction: Phương thức trừu tượng tính giá lăn bánh
        public abstract decimal TinhGiaLanBanh();

        // Virtual method: Cho phép lớp con ghi đè
        public virtual string GetInfo()
        {
            return $"Mã: {MaPT,-6} | Hãng: {TenHang,-10} | Năm SX: {NamSanXuat} | Giá gốc: {GiaGoc:N0} đ";
        }
    }

    // ==========================================
    // 2. CLASS OTO (Kế thừa)
    // ==========================================
    public class OTo : PhuongTien
    {
        public int SoChoNgoi { get; set; }
        public double DungTichDongCo { get; set; }

        public OTo(string maPT, string tenHang, int namSanXuat, decimal giaGoc, int soChoNgoi, double dungTichDongCo) 
            : base(maPT, tenHang, namSanXuat, giaGoc)
        {
            SoChoNgoi = soChoNgoi;
            DungTichDongCo = dungTichDongCo;
        }

        // Polymorphism (Đa hình): Ghi đè cách tính giá
        public override decimal TinhGiaLanBanh()
        {
            decimal thueTruocBa = GiaGoc * 0.12m;
            decimal thueTieuThuDacBiet = GiaGoc * 0.30m;

            if (SoChoNgoi <= 9)
            {
                return GiaGoc + thueTruocBa + thueTieuThuDacBiet;
            }
            else
            {
                // > 9 chỗ: Thuế TB 10%, không có thuế TTĐB trong đề bài quy định
                return GiaGoc + (GiaGoc * 0.10m);
            }
        }

        public override string GetInfo()
        {
            return base.GetInfo() + $" | Chỗ ngồi: {SoChoNgoi} | Động cơ: {DungTichDongCo}L | Giá Lăn Bánh: {TinhGiaLanBanh():N0} đ [Ô Tô]";
        }
    }

    // ==========================================
    // 3. CLASS XEMAY (Kế thừa)
    // ==========================================
    public class XeMay : PhuongTien
    {
        public int DungTichXylanh { get; set; }

        public XeMay(string maPT, string tenHang, int namSanXuat, decimal giaGoc, int dungTichXylanh) 
            : base(maPT, tenHang, namSanXuat, giaGoc)
        {
            DungTichXylanh = dungTichXylanh;
        }

        // Polymorphism: Ghi đè phương thức trừu tượng
        public override decimal TinhGiaLanBanh()
        {
            decimal thueTruocBa = DungTichXylanh < 175 ? (GiaGoc * 0.02m) : (GiaGoc * 0.05m);
            return GiaGoc + thueTruocBa;
        }

        public override string GetInfo()
        {
            return base.GetInfo() + $" | Phân khối: {DungTichXylanh}cc | Giá Lăn Bánh: {TinhGiaLanBanh():N0} đ [Xe Máy]";
        }
    }

    // ==========================================
    // 4. CLASS QUAN LY (Manager)
    // ==========================================
    public class QuanLyPhuongTien
    {
        private List<PhuongTien> _danhSachPT = new List<PhuongTien>();

        public void AddPhuongTien(PhuongTien pt)
        {
            _danhSachPT.Add(pt);
        }

        public void DisplayAll()
        {
            foreach (var pt in _danhSachPT)
            {
                Console.WriteLine(pt.GetInfo());
            }
        }

        public PhuongTien FindMaxGiaLanBanh()
        {
            if (!_danhSachPT.Any()) return null;
            // Dùng LINQ để tìm phần tử có giá trị lớn nhất
            return _danhSachPT.OrderByDescending(p => p.TinhGiaLanBanh()).First();
        }

        public List<PhuongTien> SearchByName(string keyword)
        {
            return _danhSachPT
                .Where(p => p.TenHang.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        
        public List<PhuongTien> GetAll() => _danhSachPT;
    }

